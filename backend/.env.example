# Puerto del servidor HTTP
PORT=4000

# Entorno: development | test | production
NODE_ENV=development

# Secreto para firmar los JWT. CÁMBIALO en cualquier entorno real.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1d

# Ruta del archivo SQLite (relativa al directorio backend/)
DB_STORAGE=./data/dev.sqlite

# Base de la PokeAPI (v2). No requiere API key.
POKEAPI_BASE_URL=https://pokeapi.co/api/v2

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173
